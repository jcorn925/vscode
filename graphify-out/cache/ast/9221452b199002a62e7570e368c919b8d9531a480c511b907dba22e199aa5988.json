gator.ts", "source_location": "L196"}, {"caller_nid": "node_sessiondiffaggregator_computesessiondiffs", "callee": "allSettled", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/platform/agentHost/node/sessionDiffAggregator.ts", "source_location": "L225"}, {"caller_nid": "node_sessiondiffaggregator_computesessiondiffs", "callee": "push", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/platform/agentHost/node/sessionDiffAggregator.ts", "source_location": "L230"}]}