n\t\t\t\t\t\t\tdeferredPromise.error(new Error('State does not match.'));\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tdeferredPromise.complete({ code, state });\n\t\t\t\t\t\tres.writeHead(302, { location: '/done' });\n\t\t\t\t\t\tres.end();\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t\t// Serve the static files\n\t\t\t\t\tcase '/done':\n\t\t\t\t\t\tthis._sendPage(res);\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tdefault:\n\t\t\t\t\t\tres.writeHead(404);\n\t\t\t\t\t\tres.end();\n\t\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t});\n\t\t})", "is_member_call": false, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_location": "L59"}, {"caller_nid": "node_loopbackserver_loopbackauthserver_sendpage", "callee": "writeHead", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_location": "L114"}, {"caller_nid": "node_loopbackserver_loopbackauthserver_sendpage", "callee": "byteLength", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_location": "L116"}, {"caller_nid": "node_loopbackserver_loopbackauthserver_sendpage", "callee": "end", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_location": "L118"}, {"caller_nid": "node_loopbackserver_loopbackauthserver_start", "callee": "setTimeout", "is_member_call": false, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_location": "L127"}, {"caller_nid": "node_loopbackserver_loopbackauthserver_start", "callee": "on", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_location": "L130"}, {"caller_nid": "node_loopbackserver_loopbackauthserver_start", "callee": "on", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/api/node/loopbackServer.ts", "source_locatio