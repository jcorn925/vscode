ion": "imports", "context": "import", "confidence": "EXTRACTED", "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L10", "weight": 1.0}, {"source": "users_macbookuser_vscode_src_vs_workbench_services_files_electron_browser_watcherclient_ts", "target": "electron_browser_watcherclient_universalwatcherclient", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L12", "weight": 1.0}, {"source": "electron_browser_watcherclient_universalwatcherclient", "target": "electron_browser_watcherclient_universalwatcherclient_constructor", "relation": "method", "confidence": "EXTRACTED", "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L14", "weight": 1.0}, {"source": "electron_browser_watcherclient_universalwatcherclient", "target": "electron_browser_watcherclient_universalwatcherclient_createwatcher", "relation": "method", "confidence": "EXTRACTED", "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L25", "weight": 1.0}], "raw_calls": [{"caller_nid": "electron_browser_watcherclient_universalwatcherclient_constructor", "callee": "super", "is_member_call": false, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L20"}, {"caller_nid": "electron_browser_watcherclient_universalwatcherclient_constructor", "callee": "init", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L22"}, {"caller_nid": "electron_browser_watcherclient_universalwatcherclient_createwatcher", "callee": "toService", "is_member_call": true, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L26"}, {"caller_nid": "electron_browser_watcherclient_universalwatcherclient_createwatcher", "callee": "getDelayedChannel", "is_member_call": false, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L26"}, {"caller_nid": "electron_browser_watcherclient_universalwatcherclient_createwatcher", "callee": "(async () => {\n\n\t\t\t// Acquire universal watcher via utility process worker\n\t\t\t//\n\t\t\t// We explicitly do not add the worker as a disposable\n\t\t\t// because we need to call `stop` on disposal to prevent\n\t\t\t// a crash on shutdown (see below).\n\t\t\t//\n\t\t\t// The utility process worker services ensures to terminate\n\t\t\t// the process automatically when the window closes or reloads.\n\t\t\tconst { client, onDidTerminate } = disposables.add(await this.utilityProcessWorkerWorkbenchService.createWorker({\n\t\t\t\tmoduleId: 'vs/platform/files/node/watcher/watcherMain',\n\t\t\t\ttype: 'fileWatcher',\n\t\t\t\tname: 'file-watcher'\n\t\t\t}));\n\n\t\t\t// React on unexpected termination of the watcher process\n\t\t\t// by listening to the `onDidTerminate` event. We do not\n\t\t\t// consider an exit code of `0` as abnormal termination.\n\n\t\t\tonDidTerminate.then(({ reason }) => {\n\t\t\t\tif (reason?.code === 0) {\n\t\t\t\t\tthis.trace(`terminated by itself with code ${reason.code}, signal: ${reason.signal}`);\n\t\t\t\t} else {\n\t\t\t\t\tthis.onError(`terminated by itself unexpectedly with code ${reason?.code}, signal: ${reason?.signal} (ETERM)`);\n\t\t\t\t}\n\t\t\t});\n\n\t\t\treturn client.getChannel('watcher');\n\t\t})", "is_member_call": false, "source_file": "/Users/macbookuser/vscode/src/vs/workbench/services/files/electron-browser/watcherClient.ts", "source_location": "L26"}]}